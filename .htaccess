<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|storage|database|tests|app|bootstrap|config|routes|resources) - [F,L]

    # Route all requests to the public/ directory if not already inside public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
